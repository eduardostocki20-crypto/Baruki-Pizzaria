APP_NAME=Minha Pizzaria
DATABASE_URL=sqlite:///./pizzaria.db

# Provedor de pagamento: mercado_pago, pagbank, stripe etc.
PAYMENT_PROVIDER=mercado_pago

# Credenciais privadas ficam somente no servidor, nunca no app do cliente.
PAYMENT_ACCESS_TOKEN=
PAYMENT_WEBHOOK_SECRET=

# Referência informativa da conta de recebimento (não inserir senha, CVV ou token bancário).
PAYOUT_ACCOUNT_LABEL=
PAYOUT_BANK_NAME=
PAYOUT_ACCOUNT_LAST4=
